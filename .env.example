# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Supabase (public: used by the Next.js frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Python pipeline (src/pipeline) only. Put these in .env (git-ignored). NEVER in the frontend / Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # Supabase dashboard -> Project Settings -> API -> service_role / secret key

# Optional: official Threads API experiments (scripts/api_test.py)
THREADS_ACCESS_TOKEN=

# Frontend (Vercel) server-side only: Gemini API key for the optional AI advice button. Leave empty to disable it.
LLM_API_KEY=
# LLM_MODEL=gemini-3.1-flash-lite   # default (fastest lightweight model measured via the API's model list)

# Optional: where `python -m src.pipeline.login` saves your Threads session (default .secrets/threads_state.json, git-ignored).
# THREADS_STATE=
